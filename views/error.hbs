<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css">
    <link rel="icon" type="image/png" href="/img/favicon.png?v=2">
    <link href="/css/shared.css" rel="stylesheet">
    <link href="/css/error.css" rel="stylesheet">
    <title>Animal Friends - Error</title>
</head>
<body>
    {{> header}}

    <main class="error-container">
        <div class="error-texto">
            <div class="error-card">
                <div class="error-code">{{statusCode}}</div>
                <div class="error-icon">
                    <i class="fa-solid fa-triangle-exclamation"></i>
                </div>
                <h1 class="error-title">{{titulo}}</h1>
                <p class="error-message">{{mensaje}}</p>
                <a href="/" class="btn-primary-custom error-btn">
                    <i></i>Inicio
                </a>
            </div>
        </div>

        <div class="error-imagen">
            <img src="/img/fot_para_la_pagina_error.png" alt="Mascota mirando hacia arriba">
        </div>
    </main>

    {{> footer}}
</body>
</html>