<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css">
    <link rel="icon" type="image/png" href="/img/favicon.png?v=2">
    <link href="/css/shared.css" rel="stylesheet">
    <link href="/css/crear-mascota.css" rel="stylesheet">
    <title>Animal Friends - Nueva Mascota</title>
</head>
<body>
    {{> header}}

    <main>
        <div class="card-crear">
            <div class="form-header">
                <h2>Bienvenido un Nuevo Amigo</h2>
                <p>Agrega los datos para publicar una mascota en adopción.</p>
            </div>
            <form id="formCrearMascota">
                <div class="form-body">
                    <!-- Panel izquierdo: Upload -->
                    <div class="upload-area" id="uploadArea">
                        <span class="upload-icon"><i class="fa-solid fa-camera"></i></span>
                        <span class="upload-text">Subir Foto</span>
                        <img id="preview" style="display:none;">
                        <input type="file" id="imagen" accept="image/*" hidden>
                    </div>

                    <!-- Panel derecho: Campos -->
                    <div class="form-fields">
                        <div class="form-group">
                            <label class="form-label">Nombre</label>
                            <input type="text" id="nombre" class="form-control" placeholder="Ej: Max" required>
                        </div>
                        <div class="form-row">
                            <div class="form-group">
                                <label class="form-label">Tipo</label>
                                <select id="tipo" class="form-control" required>
                                    <option value="">Seleccionar...</option>
                                    <option value="Perro">Perro</option>
                                    <option value="Gato">Gato</option>
                                    <option value="Ave">Ave</option>
                                    <option value="Otro">Otro</option>
                                </select>
                            </div>
                            <div class="form-group">
                                <label class="form-label">Sexo</label>
                                <select id="sexo" class="form-control" required>
                                    <option value="">Seleccionar...</option>
                                    <option value="Macho">Macho</option>
                                    <option value="Hembra">Hembra</option>
                                </select>
                            </div>
                            <div class="form-group">
                                <label class="form-label">Edad (Años)</label>
                                <input type="number" id="edad" class="form-control" placeholder="Ej: 2.5" min="0" max="30" step="0.5" required>
                            </div>
                        </div>
                        <div class="form-group">
                            <label class="form-label">Descripción</label>
                            <textarea id="descripcion" class="form-control" rows="3" placeholder="Cuéntanos sobre su personalidad..."></textarea>
                        </div>
                        <div class="form-group">
                            <label>
                                <input type="checkbox" id="adoptado"> ¿Ya adoptado?
                            </label>
                        </div>
                        <button type="submit" class="btn-submit">Crear Publicación →</button>
                        <div id="mensaje" class="alert d-none mt-2"></div>
                    </div>
                </div>
            </form>
        </div>
    </main>

    {{> footer}}
    <script src="/js/crear-mascota.js"></script>
</body>
</html>
