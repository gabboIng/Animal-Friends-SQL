<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css">
    <link rel="icon" type="image/png" href="/img/favicon.png?v=2">
    <link href="/css/shared.css" rel="stylesheet">
    <link href="/css/registro.css" rel="stylesheet">
    <title>Animal Friends - Registro</title>
</head>
<body class="d-flex flex-column min-vh-100">
    {{> header}}
    <main class="flex-grow-1 d-flex align-items-center justify-content-center">
        <div class="card card-registro">
            <div class="row g-0">
                <!-- Panel izquierdo: formulario -->
                <div class="col-md-7 panel-formulario">
                    <div class="marca">Animal Friends</div>
                    <h2 class="titulo-principal">Únete</h2>
                    <p class="texto-subtitulo">Crea tu cuenta para conectar con mascotas que buscan un hogar lleno de amor.</p>
                    <form id="formRegistro">
                        <div class="mb-3">
                            <label class="form-label">Nombre</label>
                            <input type="text" id="nombre" class="form-control" placeholder="Tu nombre" required>
                        </div>
                        <div class="mb-3">
                            <label class="form-label">Apellido</label>
                            <input type="text" id="apellido" class="form-control" placeholder="Tu apellido" required>
                        </div>
                        <div class="mb-3">
                            <label class="form-label">Email</label>
                            <input type="email" id="email" class="form-control" placeholder="ejemplo@correo.com" required>
                        </div>
                        <div class="mb-3">
                            <label class="form-label">Teléfono</label>
                            <input type="number" id="telefono" class="form-control" placeholder="123456789">
                        </div>
                        <div class="mb-4">
                            <label class="form-label">Contraseña</label>
                            <input type="password" id="clave" class="form-control" placeholder="Mínimo 6 caracteres" required>
                        </div>
                        <button type="submit" class="btn btn-primary-custom w-100 mb-3">Registrarse</button>
                        <p class="text-center mb-0">¿Ya tienes cuenta? <a href="/login">Inicia sesión</a></p>
                        <div id="mensaje" class="alert d-none mt-3"></div>
                    </form>
                </div>
                <!-- Panel derecho: imagen -->
                <div class="col-md-5 panel-imagen d-none d-md-flex">
                </div>
            </div>
        </div>
    </main>
    {{> footer}}
    <script src="/js/app.js"></script>
</body>
</html>